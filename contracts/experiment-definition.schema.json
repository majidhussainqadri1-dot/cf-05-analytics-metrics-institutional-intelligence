{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sabrihomeopathy.com/contracts/cf05/experiment-definition-1.4.0.json",
  "title": "CF-05 Governed Experiment Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "hypothesis",
    "assignment_owner",
    "audience",
    "primary_metrics",
    "guardrails",
    "design",
    "privacy_class"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 190
    },
    "hypothesis": {
      "type": "string",
      "minLength": 20,
      "maxLength": 5000
    },
    "assignment_owner": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{1,99}$"
    },
    "audience": {
      "type": "object"
    },
    "primary_metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10
    },
    "guardrails": {
      "type": "array",
      "maxItems": 20
    },
    "design": {
      "type": "object"
    },
    "privacy_class": {
      "enum": [
        "C1",
        "C2",
        "C3"
      ]
    },
    "starts_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ends_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
