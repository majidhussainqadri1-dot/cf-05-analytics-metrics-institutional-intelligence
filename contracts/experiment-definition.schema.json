{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sabrihomeopathy.com/contracts/cf05/experiment-definition-1.0.0.json",
  "title": "CF-05 Governed Experiment Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "hypothesis", "assignment_owner", "audience", "primary_metrics", "guardrails", "design", "privacy_class"],
  "properties": {
    "name": {"type": "string", "minLength": 3, "maxLength": 190},
    "hypothesis": {"type": "string", "minLength": 12, "maxLength": 3000},
    "assignment_owner": {"type": "string", "minLength": 2, "maxLength": 100},
    "audience": {"type": "object"},
    "primary_metrics": {"type": "array", "minItems": 1, "maxItems": 20},
    "guardrails": {"type": "array", "minItems": 1, "maxItems": 30},
    "design": {"type": "object"},
    "privacy_class": {"enum": ["C1", "C2", "C3"]},
    "enhanced_review": {"type": "boolean"},
    "starts_at": {"type": ["string", "null"], "format": "date-time"},
    "ends_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
