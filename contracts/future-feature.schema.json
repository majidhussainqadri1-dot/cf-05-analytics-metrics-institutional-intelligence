{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sabrihomeopathy.com/contracts/cf05/future-feature-1.4.0.schema.json",
  "title": "CF-05 Future Feature Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature_id", "title", "category", "phase", "risk", "state", "aggregate_only", "human_governed", "autonomous_decision"],
  "properties": {
    "feature_id": {"type": "string", "pattern": "^CF05-FUT-(00[1-9]|0[1-3][0-9]|040)$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 190},
    "category": {"type": "string", "enum": ["metric_governance", "lineage_catalog", "quality_intelligence", "institutional_intelligence", "privacy_research", "ai_intelligence"]},
    "phase": {"type": "string", "enum": ["NEXT", "SCALE", "EXPERIMENT"]},
    "risk": {"type": "string", "enum": ["standard", "elevated", "critical"]},
    "state": {"type": "string", "enum": ["disabled", "configured", "approved", "active", "paused", "retired"]},
    "aggregate_only": {"const": true},
    "human_governed": {"const": true},
    "autonomous_decision": {"const": false}
  }
}
