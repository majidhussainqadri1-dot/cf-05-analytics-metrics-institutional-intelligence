{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sabrihomeopathy.com/contracts/cf05/dataset-definition-1.4.0.json",
  "title": "CF-05 Derivative Dataset Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "dataset_version",
    "name",
    "owner_module",
    "grain",
    "privacy_class",
    "retention_days",
    "region_code",
    "provider_id",
    "sources",
    "fields"
  ],
  "properties": {
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,189}$"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 190
    },
    "owner_module": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{1,99}$"
    },
    "grain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,99}$"
    },
    "privacy_class": {
      "enum": [
        "C1",
        "C2",
        "C3"
      ]
    },
    "retention_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 730
    },
    "region_code": {
      "type": "string",
      "pattern": "^[A-Z0-9-]{2,32}$"
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{1,99}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "event_name",
          "event_version"
        ],
        "properties": {
          "event_name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,189}$"
          },
          "event_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        },
        "additionalProperties": false
      }
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 100,
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "from"
          ],
          "properties": {
            "type": {
              "enum": [
                "boolean",
                "integer",
                "number",
                "string",
                "timestamp",
                "pseudonymous_ref"
              ]
            },
            "from": {
              "type": "string",
              "pattern": "^(event|properties)\\.[a-z][a-z0-9_]{0,99}$"
            },
            "required": {
              "type": "boolean"
            },
            "max_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "description": {
              "type": "string",
              "maxLength": 500
            }
          }
        }
      },
      "additionalProperties": false
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "quality_policy": {},
    "historical_semantics": {
      "enum": [
        "current",
        "as_occurred"
      ]
    },
    "owner_contact": {
      "type": "string",
      "maxLength": 190
    }
  }
}
