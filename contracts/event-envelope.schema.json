{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sabrihomeopathy.com/contracts/cf05/event-envelope-1.3.0.json",
  "title": "CF-05 Privacy-Safe Analytics Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_name",
    "event_version",
    "occurred_at",
    "recorded_at",
    "source_module",
    "source_version",
    "source_environment",
    "purpose",
    "properties"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "event_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,189}$"
    },
    "event_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35
    },
    "source_module": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{1,99}$"
    },
    "source_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
      "maxLength": 32
    },
    "source_environment": {
      "enum": [
        "local",
        "development",
        "staging",
        "production"
      ]
    },
    "source_sequence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "actor_ref": {
      "type": [
        "string",
        "integer",
        "null"
      ],
      "maxLength": 190
    },
    "object_ref": {
      "type": [
        "string",
        "integer",
        "null"
      ],
      "maxLength": 190
    },
    "deletion_key": {
      "type": [
        "string",
        "integer",
        "null"
      ],
      "maxLength": 190
    },
    "purpose": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,189}$"
    },
    "consent_granted": {
      "type": "boolean"
    },
    "consent_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
    },
    "guardian_consent_verified": {
      "type": "boolean"
    },
    "guardian_consent_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
    },
    "policy_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
    },
    "is_minor": {
      "type": "boolean"
    },
    "region_code": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9-]{2,32}$"
    },
    "provider_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9_.-]{1,99}$"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
    },
    "correction_of_event_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "maxLength": 36
    },
    "properties": {
      "type": "object",
      "maxProperties": 100
    }
  }
}
