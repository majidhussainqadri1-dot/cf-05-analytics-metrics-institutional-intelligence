{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sabrihomeopathy.com/contracts/cf05/event-envelope-1.1.0.json",
  "title": "CF-05 Privacy-Safe Analytics Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_name", "event_version", "occurred_at", "recorded_at", "source_module", "source_version", "source_environment", "purpose", "properties"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,189}$"},
    "event_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "source_module": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{1,99}$"},
    "source_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "source_environment": {"enum": ["local", "development", "staging", "production"]},
    "source_sequence": {"type": ["integer", "null"], "minimum": 0},
    "actor_ref": {"type": ["string", "integer", "null"], "maxLength": 190},
    "object_ref": {"type": ["string", "integer", "null"], "maxLength": 190},
    "deletion_key": {"type": ["string", "integer", "null"], "maxLength": 190},
    "purpose": {"type": "string", "minLength": 3, "maxLength": 190},
    "consent_granted": {"type": "boolean"},
    "consent_version": {"type": ["string", "null"], "maxLength": 64},
    "policy_version": {"type": ["string", "null"], "maxLength": 64},
    "is_minor": {"type": "boolean"},
    "region": {"type": ["string", "null"], "maxLength": 32},
    "trace_id": {"type": ["string", "null"], "maxLength": 100},
    "correction_of_event_id": {"type": ["string", "null"], "format": "uuid"},
    "properties": {"type": "object", "maxProperties": 100}
  }
}
